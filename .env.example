# PocketBase (self-hosted)
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=your-admin-secret

# Vercel Blob (server uploads)
BLOB_READ_WRITE_TOKEN=

# Admin UI + PATCH /api/posters/[id]/moderate (cookie session)
ADMIN_MODERATION_PASSWORD=change-me-long-random

# Optional: Bearer token for admin APIs (same as moderate + /api/admin/posters)
# ADMIN_API_BEARER_TOKEN=

# Optional: canonical site URL for metadata
# PUBLIC_SITE_URL=https://example.com
